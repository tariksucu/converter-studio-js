{
  "name": "converter-studio",
  "version": "1.0.0",
  "description": "Official JavaScript and TypeScript client and command-line tool for the Converter Studio API: convert HEIC, RAW, video, audio, documents and e-books from Node.js, Deno, Bun or a browser.",
  "keywords": [
    "converter-studio",
    "file-conversion",
    "file-converter",
    "converter",
    "heic-to-jpg",
    "video-converter",
    "pdf",
    "api-client",
    "sdk",
    "cli"
  ],
  "homepage": "https://converter.studio/developers",
  "bugs": {
    "url": "https://github.com/tariksucu/converter-studio-js/issues",
    "email": "support@converter.studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariksucu/converter-studio-js.git"
  },
  "license": "MIT",
  "author": "Converter Studio <support@converter.studio> (https://converter.studio)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "converter-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "test": "node --test \"test/*.test.ts\"",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
